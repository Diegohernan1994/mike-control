# Configure in Easypanel. Do not commit a real .env file.
# Encode special characters in the user/password when using a PostgreSQL URI.
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DATABASE
ADMIN_USERNAME=diego
# Generate a unique random password, at least 24 characters. No default password.
ADMIN_PASSWORD=
# OpenAI, Telegram and SSH are not wired yet; do not load those credentials.
